{
  "expo": {
    "name": "Upande Quality",
    "slug": "upande-quality",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo.png",
    "scheme": "upandequality",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upande.quality",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan barcodes.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.upande.quality",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/upande_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 5502
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/upande_logo.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withBuildTuning",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "We use the camera to scan barcodes."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-web-browser",
      "@upande/mobile-kit",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df6f9c7d-18cd-4233-901e-a89544cabcbf"
      },
      "otaBaseUrl": "https://mark-judah.github.io/upande-quality/ota",
      "mobileKit": {
        "_help": "All of the kit's settings for this app live here. Edit the lists under \"release\"; the kit manages nativeBaseline and apkTag itself.",
        "sites": {
          "production": "https://kaitet-group.upande.com",
          "development": "http://192.168.8.4"
        },
        "versionCodeBase": 100000,
        "runtimeMajorBase": 100,
        "release": {
          "_help": "Decides APK or OTA for you. \"apk\": folders/files (globs) that need a new APK when they change, e.g. \"modules/**\". \"ota\": folders/files that are safe over the air, e.g. \"assets/fonts/**\". Built in: app/**, src/**, tests, docs, *.md are OTA; android/**, ios/**, patches/**, plugins/** are APK. A changed file in neither list builds an APK to be safe, and the release says which file to list.",
          "apk": [
            "assets/images/**"
          ],
          "ota": [
            "assets/**",
            "kaitet-web/**",
            ".vscode/**",
            "*.config.js",
            "tsconfig.json",
            "expo-env.d.ts"
          ]
        },
        "nativeBaseline": {
          "hash": "9f858a36280b",
          "parts": {
            "@react-native-async-storage/async-storage": "2.2.0",
            "@react-native-community/slider": "5.2.1",
            "@upande/mobile-kit (native modules and plugins)": "d0124cdf2975",
            "expo": "58.0.20",
            "expo-application": "58.1.2",
            "expo-asset": "58.0.18",
            "expo-audio": "58.0.10",
            "expo-battery": "58.0.4",
            "expo-build-properties": "58.0.11",
            "expo-camera": "58.0.13",
            "expo-cellular": "58.0.3",
            "expo-constants": "58.0.13",
            "expo-device": "58.0.5",
            "expo-file-system": "58.0.12",
            "expo-font": "58.0.10",
            "expo-haptics": "58.0.7",
            "expo-image": "58.0.17",
            "expo-intent-launcher": "58.0.3",
            "expo-linking": "58.0.14",
            "expo-local-authentication": "58.0.2",
            "expo-localization": "58.0.5",
            "expo-navigation-bar": "58.0.4",
            "expo-network": "58.0.4",
            "expo-router": "58.0.27",
            "expo-secure-store": "58.0.2",
            "expo-splash-screen": "58.0.11",
            "expo-sqlite": "58.0.14",
            "expo-status-bar": "58.0.4",
            "expo-symbols": "58.0.4",
            "expo-system-ui": "58.0.6",
            "expo-updates": "58.0.22",
            "expo-web-browser": "58.0.7",
            "react-native": "0.88.0",
            "react-native-gesture-handler": "3.3.0",
            "react-native-reanimated": "4.7.1",
            "react-native-safe-area-context": "5.10.1",
            "react-native-screens": "4.30.0",
            "react-native-worklets": "0.13.0",
            "app.json (native fields)": "fbf2d0bee14f"
          }
        },
        "apkTag": "v1.5.0"
      },
      "runtimeSdk": 58
    },
    "backgroundColor": "#F5F5F5",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://kaitet-group.upande.com/api/method/upande_mobile.api.ota.manifest?app=Upande%20Quality"
    },
    "runtimeVersion": "1.5"
  }
}
